{
  "name": "venture-signal-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://sanjeevk20.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [{ "name": "RESEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
